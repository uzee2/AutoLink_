<mvc:View 
 controllerName="autolink.controller.Orders"
 xmlns:mvc="sap.ui.core.mvc" 
 xmlns="sap.m">

 <Page
        id="ordersPage"
        title="Orders"
        showNavButton="true"
        navButtonPress=".onBack">

        <content>

            <VBox id="_IDGenVBox8" class="sapUiMediumMargin">

                <!-- Page Heading -->
                <Title id="_IDGenTitle7"
                    text="Order Management"
                    level="H2"
                    class="sapUiSmallMarginBottom" />

                <!-- Search Section -->
                <Panel id="_IDGenPanel2"
                    headerText="Search Order"
                    class="sapUiSmallMarginBottom">

                    <HBox id="_IDGenHBox1"
                        alignItems="Center"
                        class="sapUiSmallMargin">

                        <Label id="_IDGenLabel2"
                            text="Order ID"
                            width="100px" />

                        <Input
                            id="orderSearchInput"
                            placeholder="Enter Order ID"
                            width="250px" />

                        <Button id="_IDGenButton5"
                            text="Search"
                            type="Emphasized"
                            press=".onSearchOrder"
                            class="sapUiSmallMarginBegin" />

                    </HBox>

                </Panel>

                <!-- Orders Table -->
                <Panel id="_IDGenPanel3"
                    headerText="Orders">

                    <Table
                        id="ordersTable"
                        items="{/orders}"
                        growing="true"
                        growingThreshold="10"
                        inset="false">

                        <columns>

                            <Column id="_IDGenColumn9">
                                <Text id="_IDGenText13" text="Order ID" />
                            </Column>

                            <Column id="_IDGenColumn10">
                                <Text id="_IDGenText22" text="Customer ID" />
                            </Column>

                            <Column id="_IDGenColumn11">
                                <Text id="_IDGenText23" text="Order Date" />
                            </Column>

                            <Column id="_IDGenColumn12">
                                <Text id="_IDGenText24" text="Delivery Date" />
                            </Column>

                            <Column id="_IDGenColumn13">
                                <Text id="_IDGenText25" text="Status" />
                            </Column>

                            <Column id="_IDGenColumn14" hAlign="End">
                                <Text id="_IDGenText26" text="Total Amount" />
                            </Column>

                        </columns>

                        <items>

                            <ColumnListItem id="_IDGenColumnListItem2">

                                <cells>

                                    <ObjectIdentifier id="_IDGenObjectIdentifier1"
                                        title="{orderId}" />

                                    <Text id="_IDGenText27"
                                        text="{customerId}" />

                                    <Text id="_IDGenText28"
                                        text="{orderDate}" />

                                    <Text id="_IDGenText29"
                                        text="{requestedDeliveryDate}" />

                                    <ObjectStatus id="_IDGenObjectStatus"
                                        text="{status}" />

                                    <ObjectNumber id="_IDGenObjectNumber"
                                        number="{totalAmount}"
                                        unit="{currency}" />

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </Panel>

            </VBox>

        </content>

    </Page>


</mvc:View>