<mvc:View
    controllerName="autolink.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page
        id="homePage"
        showHeader="true">

        <content>

            <HBox
                id="mainLayout"
                class="mainLayout">

                <!-- ================= SIDEBAR ================= -->

                <VBox
                    id="sideNavigation"
                    class="sideNavigation">

                    <!-- Logo -->

                    <VBox id="_IDGenVBox" class="logoSection">

                        <Title id="_IDGenTitle"
                            text="AutoLink"
                            class="logoTitle"/>

                        <Text id="_IDGenText"
                            text="B2B Automotive Portal"
                            class="logoSubtitle"/>

                    </VBox>


                    <!-- Navigation -->

                    <VBox id="_IDGenVBox1" class="navigationItems">

                        <Button
                            id="dashboardButton"
                            text="Home"
                            icon="sap-icon://home"
                            type="Transparent"
                            width="100%"
                            class="navigationButton"
                            press=".onDashboard"/>

                        <Button
                            id="productFinderButton"
                            text="Product Finder"
                            icon="sap-icon://search"
                            type="Transparent"
                            width="100%"
                            class="navigationButton"
                            press=".onProductFinder"/>

                        <Button
                            id="ordersButton"
                            text="Orders"
                            icon="sap-icon://cart"
                            type="Transparent"
                            width="100%"
                            class="navigationButton"
                            press=".onOrders"/>

                        <Button
                            id="usersButton"
                            text="User Management"
                            icon="sap-icon://group"
                            type="Transparent"
                            width="100%"
                            class="navigationButton"
                            press=".onUsers"/>

                        <Button
                            id="formsButton"
                            text="Forms"
                            icon="sap-icon://form"
                            type="Transparent"
                            width="100%"
                            class="navigationButton"
                            press=".onForms"/>

                        

                    </VBox>


                    <!-- Bottom navigation -->

                    <VBox id="_IDGenVBox2" class="navigationBottom">

                        <Button
                            id="helpButton"
                            text="Help"
                            icon="sap-icon://sys-help"
                            type="Transparent"
                            width="100%"
                            class="navigationButton"
                            press=".onHelp"/>

                        <Button
                            id="logoutButton"
                            text="Logout"
                            icon="sap-icon://log"
                            type="Transparent"
                            width="100%"
                            class="navigationButton"
                            press=".onLogout"/>

                    </VBox>

                </VBox>


                <!-- ================= MAIN CONTENT ================= -->

                <VBox
                    id="mainContent"
                    class="mainContent">

                    <!-- Header -->

                    <HBox
                        id="topHeader"
                        class="topHeader">

                        <VBox id="_IDGenVBox3">

                            <Title id="_IDGenTitle1"
                                text="Welcome to AutoLink"
                                class="welcomeTitle"/>

                            <Text id="_IDGenText1"
                                text="Manage products, find parts and track your orders."
                                class="welcomeSubtitle"/>

                        </VBox>

                        <ToolbarSpacer id="_IDGenToolbarSpacer"/>

                        

                    </HBox>


                    <!-- Quick Access -->

                    <Title id="_IDGenTitle2"
                        text="Quick Actions"
                        class="sectionTitle"/>

                    <HBox
                        id="cardContainer"
                        class="cardContainer"
                        wrap="Wrap">


                        <!-- Product Finder -->

                        <VBox
                            id="productCard"
                            class="featureCard">

                            <core:Icon id="_IDGenIcon"
                                src="sap-icon://search"
                                size="2.5rem"
                                class="featureIcon"/>

                            <Title id="_IDGenTitle3"
                                text="Product Finder"
                                class="featureTitle"/>

                            <Text id="_IDGenText2"
                                text="Find automotive products and parts."
                                class="featureText"/>

                            <Button id="_IDGenButton"
                                text="Open"
                                type="Emphasized"
                                press=".onProductFinder"/>

                        </VBox>


                        <!-- Orders -->

                        <VBox
                            id="ordersCard"
                            class="featureCard">

                            <core:Icon id="_IDGenIcon1"
                                src="sap-icon://cart"
                                size="2.5rem"
                                class="featureIcon"/>

                            <Title id="_IDGenTitle4"
                                text="Orders"
                                class="featureTitle"/>

                            <Text id="_IDGenText3"
                                text="View and track your orders."
                                class="featureText"/>

                            <Button id="_IDGenButton1"
                                text="View Orders"
                                type="Emphasized"
                                press=".onOrders"/>

                        </VBox>


                        <!-- Account -->

                        <VBox
                            id="accountCard"
                            class="featureCard">

                            <core:Icon id="_IDGenIcon2"
                                src="sap-icon://customer"
                                size="2.5rem"
                                class="featureIcon"/>

                            <Title id="_IDGenTitle5"
                                text="Account"
                                class="featureTitle"/>

                            <Text id="_IDGenText4"
                                text="Manage your AutoLink account."
                                class="featureText"/>

                            <Button id="_IDGenButton2"
                                text="View Account"
                                press=".onAccount"/>

                        </VBox>

                    </HBox>


                    <!-- Recent Orders -->

                    <Title id="_IDGenTitle6"
                        text="Recent Orders"
                        class="sectionTitle"/>

                    <Table
                        id="recentOrdersTable"
                        items="{/orders}"
                        noDataText="No recent orders">

                        <columns>

                            <Column id="_IDGenColumn">
                                <Text id="_IDGenText5" text="Order ID"/>
                            </Column>

                            <Column id="_IDGenColumn1">
                                <Text id="_IDGenText6" text="Customer"/>
                            </Column>

                            <Column id="_IDGenColumn2">
                                <Text id="_IDGenText7" text="Status"/>
                            </Column>

                            <Column id="_IDGenColumn3">
                                <Text id="_IDGenText8" text="Date"/>
                            </Column>

                        </columns>

                        <items>

                            <ColumnListItem id="_IDGenColumnListItem">

                                <cells>

                                    <Text id="_IDGenText9" text="{orderId}"/>

                                    <Text id="_IDGenText10" text="{customer}"/>

                                    <ObjectStatus id="_IDGenObjectStatus1"
                                        text="{status}"/>

                                    <Text id="_IDGenText11" text="{date}"/>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </VBox>

            </HBox>

        </content>

    </Page>

</mvc:View>