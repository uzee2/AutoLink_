<mvc:View
    controllerName="autolink.controller.productfinder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page
        id="productFinderPage"
        title="Product Finder"
        showNavButton="true"
        navButtonPress=".onBack">

        <content>

            <!-- =====================================================
                 PAGE INTRODUCTION
                 ===================================================== -->

            <VBox id="_IDGenVBox4" class="sapUiSmallMargin">

                <Title id="_IDGenTitle8"
                    text="Product Finder"
                    level="H2" />

                <Text id="_IDGenText12"
                    text="Find compatible automotive products by selecting your vehicle."
                    class="sapUiSmallMarginBottom" />

            </VBox>


            <!-- =====================================================
                 VEHICLE SELECTION SECTION
                 ===================================================== -->

            <Panel id="_IDGenPanel1"
                headerText="Find Products by Vehicle"
                class="sapUiSmallMargin">

                <content>

                    <VBox id="_IDGenVBox5" class="sapUiMediumMargin">


                        <!-- =================================================
                             INFORMATION MESSAGE
                             ================================================= -->

                        <MessageStrip id="_IDGenMessageStrip"
                            text="Select your vehicle make, model and year to find compatible products."
                            type="Information"
                            showIcon="true"
                            class="sapUiSmallMarginBottom" />


                        <!-- =================================================
                             VEHICLE MAKE
                             Data comes from:
                             GET /v1/makes
                             ================================================= -->

                        <Label id="_IDGenLabel"
                            text="Vehicle Make"
                            required="true"
                            class="sapUiTinyMarginBottom" />

                        <Select
                            id="makeSelect"
                            width="100%"
                            selectedKey="{vehicle>/selectedMake}"
                            change=".onMakeChange"
                            items="{vehicle>/makes}">

                            <core:Item id="_IDGenItem"
                                key="{vehicle>slug}"
                                text="{vehicle>make}" />

                        </Select>


                        <!-- =================================================
                             VEHICLE MODEL
                             Data comes from:
                             GET /v1/models?make={make}
                             ================================================= -->

                        <Label id="_IDGenLabel1"
                            text="Vehicle Model"
                            required="true"
                            class="sapUiSmallMarginTop sapUiTinyMarginBottom" />

                        <Select
                            id="modelSelect"
                            width="100%"
                            enabled="{= ${vehicle>/models}.length > 0 }"
                            selectedKey="{vehicle>/selectedModel}"
                            change=".onModelChange"
                            items="{vehicle>/models}">

                            <core:Item id="_IDGenItem1"
                                key="{vehicle>slug}"
                                text="{vehicle>model}" />

                        </Select>


                        <!-- =================================================
                             MODEL YEAR
                             Years are generated from the selected
                             model's yearFrom and yearTo values.
                             ================================================= -->

                        <Label id="_IDGenLabel3"
                            text="Model Year"
                            required="true"
                            class="sapUiSmallMarginTop sapUiTinyMarginBottom" />

                        <Select
                            id="yearSelect"
                            width="100%"
                            enabled="{= ${vehicle>/years}.length > 0 }"
                            selectedKey="{vehicle>/selectedYear}"
                            items="{vehicle>/years}">

                            <core:Item id="_IDGenItem2"
                                key="{vehicle>year}"
                                text="{vehicle>year}" />

                        </Select>


                        <!-- =================================================
                             FIND PRODUCTS BUTTON
                             ================================================= -->

                        <HBox id="_IDGenHBox"
                            justifyContent="End"
                            class="sapUiMediumMarginTop">

                            <Button
                                id="findProductsButton"
                                text="Find Compatible Products"
                                type="Emphasized"
                                icon="sap-icon://search"
                                press=".onFindProducts"
                                enabled="{= !!${vehicle>/selectedMake} &amp;&amp; !!${vehicle>/selectedModel} &amp;&amp; !!${vehicle>/selectedYear} }" />

                        </HBox>

                    </VBox>

                </content>

            </Panel>


            <!-- =====================================================
                 SELECTED VEHICLE SECTION
                 ===================================================== -->

            <Panel id="_IDGenPanel4"
                headerText="Selected Vehicle"
                visible="{= !!${vehicle>/selectedMake} &amp;&amp; !!${vehicle>/selectedModel} &amp;&amp; !!${vehicle>/selectedYear} }"
                class="sapUiSmallMargin">

                <content>

                    <HBox id="_IDGenHBox2"
                        justifyContent="SpaceAround"
                        class="sapUiMediumMargin">


                        <!-- Selected Make -->

                        <VBox id="_IDGenVBox6">

                            <Label id="_IDGenLabel4"
                                text="Make" />

                            <Text id="_IDGenText14"
                                text="{vehicle>/selectedMakeName}" />

                        </VBox>


                        <!-- Selected Model -->

                        <VBox id="_IDGenVBox7">

                            <Label id="_IDGenLabel5"
                                text="Model" />

                            <Text id="_IDGenText15"
                                text="{vehicle>/selectedModelName}" />

                        </VBox>


                        <!-- Selected Year -->

                        <VBox id="_IDGenVBox9">

                            <Label id="_IDGenLabel6"
                                text="Year" />

                            <Text id="_IDGenText16"
                                text="{vehicle>/selectedYear}" />

                        </VBox>

                    </HBox>

                </content>

            </Panel>


            <!-- =====================================================
                 COMPATIBLE PRODUCTS SECTION
                 ===================================================== -->

            <Panel id="_IDGenPanel5"
                headerText="Compatible Products"
                visible="{vehicle>/productsLoaded}"
                class="sapUiSmallMargin">

                <content>

                    <List
                        id="productsList"
                        items="{vehicle>/products}">

                        <CustomListItem id="_IDGenCustomListItem">

                            <VBox id="_IDGenVBox10"
                                class="sapUiSmallMargin">


                                <!-- Product Name -->

                                <Title id="_IDGenTitle9"
                                    text="{vehicle>name}"
                                    level="H4" />


                                <!-- Product Description -->

                                <Text id="_IDGenText17"
                                    text="{vehicle>description}"
                                    class="sapUiTinyMarginTop" />


                                <!-- Product MPN -->

                                <Text id="_IDGenText18"
                                    text="{vehicle>mpn}"
                                    class="sapUiTinyMarginTop" />


                                <!-- Product Source -->

                                <Text id="_IDGenText19"
                                    text="{vehicle>source}"
                                    class="sapUiTinyMarginTop" />

                            </VBox>

                        </CustomListItem>

                    </List>

                </content>

            </Panel>



        </content>

    </Page>

</mvc:View>