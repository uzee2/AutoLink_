

  <mvc:View id="_IDGenView"
    controllerName="autolink.controller.productfinder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="productFinderPage"
        title="Product Finder"
        showNavButton="true"
        navButtonPress=".onBack">

        <content>

            <VBox id="_IDGenVBox5" class="sapUiMediumMargin">

                <!-- Page heading -->
                <Title id="_IDGenTitle8"
                    text="Product Finder"
                    level="H2"
                    class="sapUiSmallMarginBottom"/>

                <Text id="_IDGenText12"
                    text="Search for products using the criteria below."
                    class="sapUiSmallMarginBottom"/>


                <!-- Search form -->
                <Panel id="_IDGenPanel"
                    headerText="Search Products"
                    class="sapUiSmallMarginBottom">

                    <content>

                        <VBox id="_IDGenVBox6" class="sapUiMediumMargin">

                            <!-- Product Number -->
                            <Label id="_IDGenLabel"
                                text="Product / Part Number"
                                labelFor="productNumberInput"/>

                            <Input
                                id="productNumberInput"
                                placeholder="Enter product or part number"
                                width="100%"
                                class="sapUiSmallMarginBottom"/>


                            <!-- Keyword -->
                            <Label id="_IDGenLabel1"
                                text="Keyword"
                                labelFor="keywordInput"/>

                            <Input
                                id="keywordInput"
                                placeholder="Enter product keyword"
                                width="100%"
                                class="sapUiSmallMarginBottom"/>


                            <!-- Buttons -->
                            <HBox id="_IDGenHBox">

                                <Button id="_IDGenButton3"
                                    text="Search"
                                    type="Emphasized"
                                    icon="sap-icon://search"
                                    press=".onSearch"
                                    class="sapUiTinyMarginEnd"/>

                                <Button id="_IDGenButton4"
                                    text="Clear"
                                    icon="sap-icon://clear-filter"
                                    press=".onClear"/>

                            </HBox>

                        </VBox>

                    </content>

                </Panel>


                <!-- Results -->
                <Panel id="_IDGenPanel1"
                    headerText="Search Results"
                    class="sapUiSmallMarginBottom">

                    <content>

                        <VBox id="_IDGenVBox7" class="sapUiMediumMargin">

                            <Text
                                id="resultCount"
                                text="No search performed yet."
                                class="sapUiSmallMarginBottom"/>


                            <Table
                                id="productTable"
                                items="{/products}"
                                growing="true"
                                growingThreshold="10"
                                noDataText="No products found">

                                <columns>

                                    <Column id="_IDGenColumn4">
                                        <Text id="_IDGenText14" text="Product"/>
                                    </Column>

                                    <Column id="_IDGenColumn5">
                                        <Text id="_IDGenText15" text="Description"/>
                                    </Column>

                                    <Column id="_IDGenColumn6">
                                        <Text id="_IDGenText16" text="Brand"/>
                                    </Column>

                                    <Column id="_IDGenColumn7">
                                        <Text id="_IDGenText17" text="Category"/>
                                    </Column>

                                    <Column id="_IDGenColumn8">
                                        <Text id="_IDGenText18" text="Availability"/>
                                    </Column>

                                </columns>


                                <items>

                                    <ColumnListItem id="_IDGenColumnListItem1">

                                        <cells>

                                            <ObjectIdentifier id="_IDGenObjectIdentifier"
                                                title="{productId}"
                                                text="{productName}"/>

                                            <Text id="_IDGenText19"
                                                text="{description}"/>

                                            <Text id="_IDGenText20"
                                                text="{brand}"/>

                                            <Text id="_IDGenText21"
                                                text="{category}"/>

                                            <ObjectStatus id="_IDGenObjectStatus2"
                                                text="{availability}"
                                                state="{availabilityState}"/>

                                        </cells>

                                    </ColumnListItem>

                                </items>

                            </Table>

                        </VBox>

                    </content>

                </Panel>

            </VBox>

        </content>

    </Page>

</mvc:View>
    
